{
  "name": "@mutineerjs/tidemark",
  "version": "0.3.2",
  "description": "Snapshot testing for LLM features — detect prompt/model/schema drift before production does",
  "author": "Billy Jones",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutineerjs/tidemark.git"
  },
  "homepage": "https://github.com/mutineerjs/tidemark#readme",
  "bugs": {
    "url": "https://github.com/mutineerjs/tidemark/issues"
  },
  "keywords": [
    "llm",
    "snapshot",
    "testing",
    "vitest",
    "drift",
    "ai",
    "zod",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "BENCHMARK.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": [
    "./dist/jest/index.js",
    "./dist/jest/index.cjs",
    "./dist/vitest/index.js",
    "./dist/vitest/index.cjs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "import": "./dist/vitest/index.js",
      "require": "./dist/vitest/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./jest": {
      "types": "./dist/jest/index.d.ts",
      "import": "./dist/jest/index.js",
      "require": "./dist/jest/index.cjs"
    }
  },
  "peerDependencies": {
    "vitest": "^4.1.7",
    "jest": ">=29.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "dependencies": {
    "diff": "^9.0.0",
    "fast-deep-equal": "^3.1.3",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@jest/globals": "^29.7.0",
    "@mutineerjs/mutineer": "^0.12.6",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "jiti": "^2.7.0",
    "openai": "^6.39.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "mutineer run --full",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
